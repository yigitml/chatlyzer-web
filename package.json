{
  "name": "chatlyzer-web",
  "version": "0.4.8",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "check:contracts": "node scripts/check-api-contract-drift.mjs",
    "check:env:production": "node --import tsx scripts/validate-production-env.mjs",
    "start:cloud": "npm run check:env:production && node scripts/start-standalone.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:schema": "node scripts/check-schema-consistency.mjs",
    "test:migrations": "node scripts/test-migration-upgrade.mjs",
    "jobs:reconcile": "node --import tsx scripts/reconcile-analysis-jobs.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-oauth/google": "^0.12.2",
    "@revenuecat/purchases-js": "^1.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "google-auth-library": "^10.5.0",
    "js-tiktoken": "^1.0.21",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.561.0",
    "next": "^16.0.10",
    "next-themes": "^0.4.6",
    "openai": "^6.10.0",
    "pg": "^8.16.3",
    "posthog-js": "^1.306.1",
    "posthog-node": "^5.17.2",
    "rate-limiter-flexible": "^9.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.0.0",
    "tailwind-merge": "^3.4.0",
    "tinyld": "^1.3.4",
    "tsx": "^4.23.15",
    "uuid": "^13.0.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "overrides": {
    "postcss": ">=8.5.10",
    "@hono/node-server": ">=1.19.13",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.2",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "~19.2.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.10",
    "prettier": "^3.7.4",
    "prisma": "^7.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
