datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  createdAt        DateTime          @default(now())
  isOnboarded      Boolean           @default(false)
  image            String?
  googleId         String?           @unique
  polarCustomerId  String?
  files            File[]
  credits          UserCredit[]
  subscription     Subscription?
  orders           Order[]
  revenueCatPurchases RevenueCatPurchase[]
  tokenVersion     Int               @default(0)
  devices          UserDevice[]
  sessions         UserSession[]
  lastLoginAt      DateTime?
  isActive         Boolean           @default(true)
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  chats            Chat[]
  messages         Message[]
  analyzes         Analysis[]
  analysisJobs     AnalysisJob[]
}

model UserSession {
  id             String    @id @default(cuid())
  sessionId      String
  loginGeneration String @default(uuid())
  refreshTokenVersion Int @default(0)
  lastActivityAt DateTime
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  deletedAt      DateTime?

  @@unique([userId, sessionId])
  @@index([userId, deletedAt, lastActivityAt])
}

model UserDevice {
  id          String    @id @default(cuid())
  deviceId    String
  loginGeneration String @default(uuid())
  refreshTokenVersion Int @default(0)
  lastLoginAt DateTime
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  deletedAt   DateTime?

  @@unique([userId, deviceId])
  @@index([userId, deletedAt, lastLoginAt])
}

model Subscription {
  id           String       @id @default(cuid())
  name         String
  price        Float
  credits      UserCredit[]
  isActive     Boolean      @default(false)
  durationDays Int
  createdAt    DateTime     @default(now())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id])
  deletedAt    DateTime?
}

model UserCredit {
  id             String        @id @default(cuid())
  user           User          @relation(fields: [userId], references: [id])
  userId         String
  type           CreditType
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?
  totalAmount    Int           @default(0)
  amount         Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  minimumBalance Int           @default(0)
  sandboxAmount  Int           @default(0)
  sandboxTotalAmount Int       @default(0)
  deletedAt      DateTime?

  @@unique([userId, type])
}

model Order {
  id             String    @id @default(cuid())
  polarOrderId   String
  polarMode      String    @default("production")
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  productId      String
  amount         Int
  currency       String    @default("usd")
  creditsGranted Int       @default(0)
  status         String    @default("paid")
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  @@unique([polarOrderId, polarMode])
}

model RevenueCatPurchase {
  id                     String    @id @default(cuid())
  revenueCatTransactionId String   @unique
  storeTransactionId     String?
  userId                 String
  user                   User      @relation(fields: [userId], references: [id])
  productId              String
  store                  String?
  purchasedAt            DateTime?
  creditsGranted         Int       @default(0)
  rawPayload             Json?
  environment            String @default("legacy")
  reversedAt             DateTime?
  createdAt              DateTime  @default(now())
  deletedAt              DateTime?

  @@index([userId])
  @@index([productId])
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CreditType {
  ANALYSIS
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model File {
  id        String    @id @default(cuid())
  url       String
  size      Int
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  chatId    String?
  chat      Chat?     @relation(fields: [chatId], references: [id])
  deletedAt DateTime?
  @@index([userId, deletedAt])
  @@index([chatId, userId, deletedAt])
}

model Chat {
  id               String            @id @default(cuid())
  title            String?
  participants     Json              @default("[]") // A JSON array of strings i.e. ["yagmur", "yigit"]
  isPrivacy        Boolean           @default(false) // Flag for privacy chats
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  messages         Message[]
  analyzes         Analysis[]
  files            File[]
  @@index([userId, deletedAt, createdAt])
  @@index([userId, title, deletedAt])
}

model Message {
  id        String    @id @default(cuid())
  chatId    String
  chat      Chat      @relation(fields: [chatId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  sender    String
  timestamp DateTime
  content   String
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  @@index([chatId, deletedAt, timestamp])
  @@index([userId, deletedAt])
}

model Analysis {
  id        String         @id @default(cuid())
  chatId    String
  chat      Chat           @relation(fields: [chatId], references: [id])
  result    Json?
  status    AnalysisStatus @default(PENDING)
  error     String?
  requestKey String?
  jobId     String?
  job       AnalysisJob? @relation(fields: [jobId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
  User      User           @relation(fields: [userId], references: [id])
  userId    String

  @@index([userId, requestKey])
  @@index([chatId, requestKey])
  @@index([userId, deletedAt, status])
  @@index([chatId, userId, deletedAt])
  @@index([jobId])
}

// Content-free request reservation and debit recovery ledger, including ghost mode.
model AnalysisJob {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  requestKey String
  mode String
  chatId String?
  status String @default("PROCESSING")
  accountVersion Int
  leaseExpiresAt DateTime
  debitAmount Int @default(8)
  debitEnvironment String @default("production")
  refundedAt DateTime?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  analyses Analysis[]
  @@unique([userId, requestKey])
  @@index([status, leaseExpiresAt])
}

model RevenueCatEvent {
  id String @id
  type String
  disposition String
  eventTimestamp BigInt @default(0)
  createdAt DateTime @default(now())
}

model RateLimit {
  key String @id @db.VarChar(255)
  points Int @default(0)
  expire BigInt?
  @@index([expire], map: "rate_limits_expire_idx")
  @@map("rate_limits")
}
