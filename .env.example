DATABASE_URL="postgresql://user:password@localhost:5432/chatlyzer"
JWT_SECRET="replace-with-long-random-secret"
REFRESH_TOKEN_SECRET="replace-with-long-random-refresh-secret"
OPENAI_API_KEY="sk-your-openai-key"
GOOGLE_OAUTH2_URL="https://www.googleapis.com/oauth2/v3"

NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=""
NEXT_PUBLIC_REVENUECAT_CREDITS_PRODUCT_ID="credits_24"

REVENUECAT_SECRET_API_KEY=""
REVENUECAT_WEBHOOK_SECRET=""
REVENUECAT_CREDITS_PRODUCT_ID="credits_24"
REVENUECAT_CREDITS_PER_PURCHASE="24"

# Optional: extra browser/mobile origins, comma-separated. Same-origin web needs none.
CORS_ALLOWED_ORIGINS=""

# Public production excludes sandbox funds. Use sandbox only in isolated testing.
REVENUECAT_FULFILLMENT_MODE="production"
# Google client IDs for each supported client; absent means NEXT_PUBLIC_GOOGLE_CLIENT_ID only.
GOOGLE_ALLOWED_CLIENT_IDS=""
# Enable only when ingress overwrites the specified header. "none" uses a shared anonymous bucket.
TRUSTED_CLIENT_IP_HEADER="none"
NEXT_PUBLIC_APP_URL="https://chatlyzerai.com"
